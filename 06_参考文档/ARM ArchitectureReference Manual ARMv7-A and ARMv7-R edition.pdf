      <rdf:Description rdf:about=""
            xmlns:dc="http://purl.org/dc/elements/1.1/">
         <dc:format>application/pdf</dc:format>
         <dc:title>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">ARM Architecture Reference Manual ARMv7-A and ARMv7-R edition</rdf:li>
            </rdf:Alt>
         </dc:title>
         <dc:creator>
            <rdf:Seq>
               <rdf:li>ARM Limited</rdf:li>
            </rdf:Seq>
         </dc:creator>
         <dc:description>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">Defines the ARMv7-A (Application) and ARMv7-R (Real-time) architecture profiles, the ARM and Thumb instruction sets, the Debug Architecture and the Generic Timer and Performance Monitors Extensions. The A profile defines a Virtual Memory System Architecture (VMSA). The R profile defines a Protected Memory System Architecture (PMSA).</rdf:li>
            </rdf:Alt>
         </dc:description>
      </rdf:Description>
      <rdf:Description rdf:about=""
            xmlns:pdfx="http://ns.adobe.com/pdfx/1.3/">
